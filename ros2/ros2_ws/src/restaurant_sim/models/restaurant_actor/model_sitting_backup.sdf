                    <pose>0 0 1.0 0 0 0</pose>
                </waypoint>
                <waypoint>
                    <time>3</time>
                    <pose>0 0 0.6 0 0 0</pose>
                </waypoint>
            </trajectory>
            <trajectory id="1" type="sitting">
                <waypoint>
                    <time>0</time>
                    <pose>0 0 0.6 0 0 0</pose>
                </waypoint>
                <waypoint>
                    <time>3600</time>
