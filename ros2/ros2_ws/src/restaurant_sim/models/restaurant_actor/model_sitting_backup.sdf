        </animation>
        <animation name="run">
            <filename>meshes/run.dae</filename>
            <scale>1.0</scale>
            <interpolate_x>true</interpolate_x>
        </animation>
        <animation name="stand">
            <filename>meshes/stand.dae</filename>
            <scale>1.0</scale>
