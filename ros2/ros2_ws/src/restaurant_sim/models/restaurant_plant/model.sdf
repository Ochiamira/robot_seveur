<?xml version="1.0"?>
<sdf version="1.10">
  <model name="restaurant_plant">
    <static>true</static>

    <link name="plant_link">
      <!-- Collision du pot détectable par le robot -->
      <collision name="pot_collision">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="pot_visual">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.45 0.16 0.07 1</ambient>
          <diffuse>0.65 0.25 0.10 1</diffuse>
        </material>
      </visual>

      <visual name="soil_visual">
        <pose>0 0 0.51 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.24</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.05 0.02 1</ambient>
          <diffuse>0.15 0.08 0.03 1</diffuse>
        </material>
      </visual>

      <visual name="trunk_visual">
        <pose>0 0 0.83 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.65</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.08 0.03 1</ambient>
          <diffuse>0.30 0.12 0.04 1</diffuse>
        </material>
      </visual>

      <visual name="lower_foliage">
        <pose>0 0 1.12 0 0 0</pose>
        <geometry>
          <sphere><radius>0.38</radius></sphere>
        </geometry>
        <material>
          <ambient>0.03 0.30 0.08 1</ambient>
          <diffuse>0.05 0.48 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="upper_foliage">
        <pose>0.08 0 1.43 0 0 0</pose>
        <geometry>
          <sphere><radius>0.29</radius></sphere>
        </geometry>
        <material>
          <ambient>0.04 0.38 0.10 1</ambient>
          <diffuse>0.06 0.58 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>